while True:
    entrada = input("\nDigite o número para ver a tabuada (1 a 10): ")

    # Verifica se o usuário digitou algo e se é número
    if not entrada.isdigit():
        print("⚠️ Entrada inválida! Digite um número entre 1 e 10.")
        continue  # volta para o início do loop

    numero = int(entrada)

    # Verifica se está dentro do intervalo permitido
    if numero < 1 or numero > 10:
        print("⚠️ Número fora do intervalo! Digite um número de 1 a 10.")
        continue

    # Se chegou aqui, é válido — mostra a tabuada e encerra o loop
    print(f"\nTabuada do {numero}:")
    for i in range(1, 11):
        resultado = numero * i
        print(f"{numero} x {i} = {resultado}")
    break  # encerra o loop após mostrar a tabuada
